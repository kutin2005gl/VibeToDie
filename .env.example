# Copy to .env (git-ignored) and fill in. Never commit real keys (B-03).

# Which model runs each agent tier (strong/standard/cheap), and the effort, is set in
# ai/app/models.json and in each mandate; only the keys live here.
ANTHROPIC_API_KEY=

OPENAI_API_KEY=
# Required for the openai provider; pick the model in B-01.
OPENAI_MODEL=

# 1 = allow the offline "fake" provider (UI work/tests only, never demo evidence).
AI_ALLOW_FAKE=1
# 1 only when ai-service sits behind the Go gateway: trust its X-User-Id / X-User-Departments.
# Otherwise every request runs as the demo CSKH user. docker compose sets it (ai has no public port).
AI_TRUST_IDENTITY_HEADERS=

# Gateway (gateway/): verifies the HS256 access tokens user-service signs with the same secret/issuer.
# Required, at least 32 characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=
JWT_ISSUER=nexus
# user-service signs tokens with the same JWT_SECRET/JWT_ISSUER. On a fresh database it creates
# this admin (department executive), who grants departments to other accounts.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional: user-service's own Postgres (e.g. Neon). Empty = the local db container.
USER_DATABASE_URL=
# Optional: order-service's own Postgres (e.g. Neon). Empty = the local db container.
# Load the real data once: see order-service/scripts/import_csv.py.
ORDERS_DATABASE_URL=
# Internal gRPC ai -> order-service: set both (e.g. order-service:9090 and a long random string) to switch from HTTP
ORDERS_GRPC_ADDR=
INTERNAL_TOKEN=
# Upstream not in docker-compose yet
ORDERS_SERVICE=http://orders-service:8080

# SMTP for send_email, run only after staff approve it (STARTTLS). Gmail: smtp.gmail.com, 587, an app password.
# Empty SMTP_HOST = approved emails fail instead of being sent. MAIL_FROM defaults to SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ai-service's Postgres for staff sessions (e.g. Neon). Empty = in memory, lost on restart.
# Also holds the policy chunks and their vectors (ai/README.md).
AI_DATABASE_URL=
# Policy search: bm25 (default) or hybrid (BM25 + vectors from the embedding service, needs the chunks loaded)
AI_RETRIEVER=
# Embedding model and its size; change both together, then load the chunks again (bge-m3: 1024)
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

POSTGRES_PASSWORD=nexus-dev-only

# Slack bot (slack/README.md). Token pair from your Slack app; not needed when SLACK_DRY_RUN=1
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Encrypts the refresh tokens the bot keeps. 32 random bytes, base64: openssl rand -base64 32
SLACK_TOKEN_KEY=
# Model provider for new sessions (anthropic by default; fake needs AI_ALLOW_FAKE=1)
NEXUS_PROVIDER=
# 1 = no Slack: type events on stdin, read the replies on stdout
SLACK_DRY_RUN=
# Web address for the bot's "Mở trên web" button (e.g. http://localhost:3000); empty: no button
BOA_WEB_URL=
# Postgres for the bot (default: the local db; set to use e.g. Neon)
SLACK_DATABASE_URL=
