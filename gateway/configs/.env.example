# The gateway reads these from the environment (docker compose sets them from the root .env).
PORT=8080

# Shared with user-service, which signs the HS256 access tokens. At least 32 characters.
JWT_SECRET=
JWT_ISSUER=nexus

USER_SERVICE=http://localhost:8081
ORDERS_SERVICE=http://localhost:8082
AI_SERVICE=http://localhost:8000

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://wails.localhost
# Comma-separated IPs/CIDRs of proxies in front of the gateway whose X-Forwarded-For is trusted.
TRUSTED_PROXIES=
# ROUTES_FILE=configs/routes.yaml
